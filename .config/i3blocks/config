[mpc-power]
command=$HOME/.config/i3blocks/mpc-power.sh;
interval=once
signal=3
separator_block_width=5

[mpc-current-playlist]
command=$HOME/bin/mpc-current-playlist;
interval=once
signal=3
separator_block_width=5
color=7199a8

[separator]
full_text=||
color=7199a8

[mpc-current-song]
command=$HOME/.config/i3blocks/mpc-current-song.sh;
interval=once
signal=3
separator_block_width=5

[mpc-previous]
full_text=❚◄
command=$HOME/.config/i3blocks/mpc-previous.sh;
signal=3
separator_block_width=5

[mpc-play-pause]
command=$HOME/.config/i3blocks/mpc-play-pause.sh;
signal=3
interval=once
separator_block_width=5

[mpc-next]
full_text=►❚
command=$HOME/.config/i3blocks/mpc-next.sh;
signal=3
separator_block_width=5

[separator]
full_text=||
color=7199a8

[vpn]
command=$HOME/.config/i3blocks/vpn.sh;
interval=once
signal=6
separator_block_width=5

[brightness]
command=$HOME/.config/i3blocks/brightness.sh;
interval=once
signal=1
separator_block_width=5

[volume-mute]
command=$HOME/.config/i3blocks/volume-mute.sh;
interval=once
signal=2
separator_block_width=5

[volume-show]
command=$HOME/.config/i3blocks/volume-show.sh;
interval=once
signal=2
separator_block_width=5

[volume-device]
command=$HOME/.config/i3blocks/volume-device.sh;
interval=once
signal=5
separator_block_width=5

[volume-poll]
command=$HOME/.config/i3blocks/volume-poll.sh;
interval=once
separator_block_width=5

[audio-poll]
command=pkill -SIGRTMIN+2 i3blocks; pkill -SIGRTMIN+5 i3blocks;
interval=600
separator_block_width=5

[microphone-mute]
command=$HOME/.config/i3blocks/microphone-mute.sh;
interval=once
signal=2
separator_block_width=5

[microphone-show]
command=$HOME/.config/i3blocks/microphone-show.sh;
interval=once
signal=2
separator_block_width=5

[battery]
command=$HOME/.config/i3blocks/battery.sh;
interval=60
separator_block_width=5

[ram]
full_text=📚
command=foot -a i3blocks-ram htop;
separator_block_width=5

[ram-show]
command=$HOME/.config/i3blocks/ram-show.sh;
interval=1
separator_block_width=5

[network-list]
command=$HOME/.config/i3blocks/network-list.sh;
interval=5
separator_block_width=5

[media]
full_text=💾
command=foot -a i3blocks-media $HOME/bin/media;
separator_block_width=5

[storage]
full_text=📁
command=foot -a i3blocks-storage $HOME/bin/storage;
separator_block_width=5

[gammastep]
command=$HOME/.config/i3blocks/gammastep.sh;
interval=once
markup=pango
signal=4
separator_block_width=5

[passmenu]
full_text=🔑
command=foot $HOME/bin/passmenu;
separator_block_width=5

[calendar]
full_text=🕛
command=foot -a i3blocks-calendar $HOME/bin/calendar;
separator_block_width=5

[datetime]
command=$HOME/.config/i3blocks/datetime.sh;
interval=1
separator_block_width=5

[keyboard-layout]
command=$HOME/.config/i3blocks/keyboard-layout.sh;
interval=1
separator_block_width=5

[power]
full_text=🔌
command=$HOME/.config/i3blocks/power.sh;
separator_block_width=5
