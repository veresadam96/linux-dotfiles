client
verb 3
explicit-exit-notify
nobind
reneg-sec 0
persist-key
persist-tun

#route-noexec
#ifconfig-noexec

ca ca.crt
key example.key
cert example.crt
remote proxy.example.hu 1194 udp

dev tun
dhcp-option DNS 192.168.1.227
pull

setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
script-security 2
up vpn-up.sh
down vpn-down.sh
down-pre

# Routes
route-metric 4000

# route clash on 192.168.0.0/24
route 192.168.0.22 255.255.255.255 10.9.0.45 0
route 192.168.0.32 255.255.255.255 10.9.0.45 0
route 192.168.0.102 255.255.255.255 10.9.0.45 0
route 192.168.0.109 255.255.255.255 10.9.0.45 0
route 192.168.0.206 255.255.255.255 10.9.0.45 0
route 192.168.0.208 255.255.255.255 10.9.0.45 0

# 192.168.0.0/23 is fine
#route 192.168.1.165 255.255.255.255 10.9.0.45 0
#route 192.168.1.210 255.255.255.255 10.9.0.45 0
#route 192.168.1.215 255.255.255.255 10.9.0.45 0
